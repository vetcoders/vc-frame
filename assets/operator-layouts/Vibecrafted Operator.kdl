                y 8
            }
            pane cwd="/Users/polyversai" {
                height "90%"
                width "90%"
                x "5%"
                y 9
            }
            pane cwd="/Users/polyversai" {
                height "90%"
                width "90%"
                x 10
                y 10
            }
        }
    }
    swap_floating_layout name="spread" {
        floating_panes max_panes=1 {
            pane cwd="/Users/polyversai" {
                x "50%"
                y "50%"
            }
        }
        floating_panes max_panes=2 {
            pane cwd="/Users/polyversai" {
                width "45%"
                x "1%"
                y "25%"
            }
            pane cwd="/Users/polyversai" {
                width "45%"
                x "50%"
                y "25%"
            }
        }
        floating_panes max_panes=3 {
            pane cwd="/Users/polyversai" {
                height "45%"
                width "45%"
                y "55%"
            }
            pane cwd="/Users/polyversai" {
                width "45%"
                x "1%"
                y "1%"
            }
            pane cwd="/Users/polyversai" {
                width "45%"
                x "50%"
                y "1%"
            }
        }
        floating_panes max_panes=4 {
            pane cwd="/Users/polyversai" {
                height "45%"
                width "45%"
                x "1%"
                y "55%"
            }
            pane cwd="/Users/polyversai" {
                height "45%"
